# =====================================================
# Next.js Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# These are used by server-side API routes (not exposed to the browser).
# =====================================================

# AWS credentials for server-side API routes (Cognito, DynamoDB, STS)
CUSTOM_REGION=us-east-1
CUSTOM_ACCESS_KEY_ID=
CUSTOM_SECRET_ACCESS_KEY=

# Cognito configuration (from CDK outputs: IcarusUserPoolId, IcarusUserPoolClientId)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# API Gateway endpoint (from CDK output: IcarusApiEndpoint)
API_ENDPOINT=

# DynamoDB Main table name (from CDK: main-<ACCOUNT_ID>)
MAIN_TABLE_NAME=
